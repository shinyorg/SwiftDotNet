<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- One MauiProgram, three heads. Windows needs Windows to build, so it is added conditionally. -->
    <TargetFrameworks>net10.0-ios;net10.0-maccatalyst;net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SampleApp.Skia.Maui</RootNamespace>
    <ApplicationTitle>SwiftDotNet Skia MAUI</ApplicationTitle>
    <ApplicationId>com.swiftdotnet.skia.maui</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <DefineConstants Condition="'$(NoShiny)' == 'true'">$(DefineConstants);NO_SHINY</DefineConstants>
    <!-- The one MAUI version this head pins (see the Microsoft.Maui.Controls reference below). Must be
         >= the highest Microsoft.Maui.Core any dependency asks for, or NuGet floats the halves apart. -->
    <SwiftDotNetMauiVersion>10.0.80</SwiftDotNetMauiVersion>
  </PropertyGroup>

  <!-- Per-head minimums: an iOS/Catalyst version string, an Android API level. -->
  <PropertyGroup Condition="$(TargetFramework.Contains('-ios')) Or $(TargetFramework.Contains('-maccatalyst'))">
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <PropertyGroup Condition="$(TargetFramework.Contains('-android'))">
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SwiftDotNet.Skia.Maui\SwiftDotNet.Skia.Maui.csproj" />
    <ProjectReference Include="..\SharedUI\SharedUI.csproj" />
  </ItemGroup>

  <!-- On the iOS TFM the app's ProjectReference graph resolves SwiftDotNet to its *net10.0-ios* slice,
       which carries the SwiftUI bridge's P/Invokes (swiftdotnet_render, …). The Skia backend never calls
       them, but the native linker still has to resolve the symbols, and NativeReference items don't flow
       transitively — so the app that produces the final binary must declare the xcframework itself. -->
  <Import Project="..\..\src\SwiftDotNet\SwiftDotNetBridge.targets" />

  <!-- Shiny: MAUI hosting + a flagship cross-platform plugin (BluetoothLE) to prove shared DI. -->
  <ItemGroup Condition="'$(NoShiny)' != 'true'">
    <PackageReference Include="Shiny.Hosting.Maui" Version="5.2.3" />
    <PackageReference Include="Shiny.BluetoothLE" Version="5.2.3" />
  </ItemGroup>

  <!-- MAUI's two halves must be the SAME version. Since .NET 8, <UseMaui> no longer implies package
       references (warning MA002): the workload supplies Microsoft.Maui.Controls.Core at the manifest's
       version, while a transitive dependency (Shiny 5.2.3 → Microsoft.Maui.Core 10.0.80) can float the
       *other* half higher. The halves then disagree and the app dies at launch with
       `TypeLoadException: VTable setup of type Microsoft.Maui.Controls.Page failed`. Referencing
       Microsoft.Maui.Controls explicitly pins both halves together. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(SwiftDotNetMauiVersion)" />
  </ItemGroup>

</Project>
