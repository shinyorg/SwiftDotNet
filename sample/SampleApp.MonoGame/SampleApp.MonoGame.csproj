<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Self-drawing SkiaSharp inside a MonoGame game loop. -->
    <SwiftDotNetPlatform>skia</SwiftDotNetPlatform>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- MonoGame ships its content pipeline as an MSBuild task that wants a Content.mgcb; this sample has
         no content of its own (the UI is drawn, not loaded), so the pipeline stays out of the build. -->
    <EnableMGCBEditor>false</EnableMGCBEditor>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SwiftDotNet.MonoGame\SwiftDotNet.MonoGame.csproj" />
    <ProjectReference Include="..\SharedUI\SharedUI.csproj" />
    <ProjectReference Include="..\SampleApp.Skia.Renderers\SampleApp.Skia.Renderers.csproj" />
  </ItemGroup>

  <!-- The game picks the MonoGame platform package; the backend library only compiled against it. -->
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5.1" />
  </ItemGroup>

</Project>
