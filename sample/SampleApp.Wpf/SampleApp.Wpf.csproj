<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Default platform version (7.0). Raising it to 10.0.19041 would also match SwiftDotNet's WinUI 3
         TFM and pull that backend into the same compilation. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- SwiftDotNetPlatform is derived as `wpf` from UseWPF — see msbuild/SwiftDotNet.Platform.targets. -->
    <OutputType>WinExe</OutputType>
    <!-- Compiles on macOS/Linux so CI and the primary dev machine can catch breaks; running needs Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- No App.xaml: the head is a plain Main, so nothing should look for a XAML startup URI. -->
    <StartupObject>SwiftDotNet.Sample.Wpf.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SwiftDotNet.Wpf\SwiftDotNet.Wpf.csproj" />
    <ProjectReference Include="..\SharedUI\SharedUI.csproj" />
  </ItemGroup>

</Project>
