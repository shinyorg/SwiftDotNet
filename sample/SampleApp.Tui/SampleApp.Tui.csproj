<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- XenoAtom.Terminal.UI; a plain net10.0 console exe, so the TFM cannot say this. -->
    <SwiftDotNetPlatform>tui</SwiftDotNetPlatform>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Block glyphs and box-drawing characters are the whole point of this backend. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SwiftDotNet.Tui\SwiftDotNet.Tui.csproj" />
    <ProjectReference Include="..\SharedUI\SharedUI.csproj" />
  </ItemGroup>

  <!-- Real Sixel/Kitty images, opted into with SDN_TUI_GRAPHICS=1 at runtime. Referenced here so the
       sample can demonstrate both image paths; a real app takes this only if it wants pixel images. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\SwiftDotNet.Tui.Graphics\SwiftDotNet.Tui.Graphics.csproj" />
  </ItemGroup>

</Project>
