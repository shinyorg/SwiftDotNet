<?xml version="1.0" encoding="utf-8"?>
<!-- Flexible space. Space is not RemoteViews-inflatable either; a weighted empty TextView is.
     The weight lives in the layout because a child added via addView keeps its own root layout params. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sdn_root"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:text="" />
