<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1"/>
        <PackageReference Include="xunit" Version="2.9.2"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Reference the plain net10.0 build of the core runtime (no platform head needed). -->
        <ProjectReference Include="..\..\src\SwiftDotNet\SwiftDotNet.csproj"/>
        <!-- The Skia self-drawing backend is pure C# + SkiaSharp (runs headless on macOS/Linux/Windows),
             so it can be driven directly in tests to exercise host-side patch application. -->
        <ProjectReference Include="..\..\src\SwiftDotNet.Skia\SwiftDotNet.Skia.csproj"/>
        <!-- The WebGPU backend renders through wgpu-native, which works headless (offscreen texture +
             readback) — so its shader output can be asserted on rather than merely compiled. Tests that
             need a GPU skip themselves when no adapter is available, so CI without one stays green. -->
        <ProjectReference Include="..\..\src\SwiftDotNet.WebGpu\SwiftDotNet.WebGpu.csproj"/>
        <!-- The terminal backend is plain net10.0 and builds its visual tree without a TTY, so unlike the
             GTK/Web backends it can be driven headlessly here. -->
        <ProjectReference Include="..\..\src\SwiftDotNet.Tui\SwiftDotNet.Tui.csproj"/>
        <!-- The ported controls library — pure composition over the core, driven headless in tests. -->
        <ProjectReference Include="..\..\src\SwiftDotNet.Controls\SwiftDotNet.Controls.csproj"/>
        <ProjectReference Include="..\..\src\SwiftDotNet.Controls.Camera\SwiftDotNet.Controls.Camera.csproj"/>
        <!-- The live-surface vocabulary and the widget timeline model. Both are plain net10.0 and
             platform-free by design, so the compact wire, the validator, the channel round trip and the
             timeline selection rule are all exercised headlessly here - which matters more than usual,
             because the platforms these target fail silently rather than throwing. -->
        <ProjectReference Include="..\..\src\SwiftDotNet.Live\SwiftDotNet.Live.csproj"/>
        <ProjectReference Include="..\..\src\SwiftDotNet.Widgets\SwiftDotNet.Widgets.csproj"/>
        <!-- The IDE-facing dev-tools channel (patch tap + socket protocol) and the preview host that
             rides on it. Both are plain net10.0, so they are testable on the same terms as Skia. -->
        <ProjectReference Include="..\..\src\SwiftDotNet.DevTools\SwiftDotNet.DevTools.csproj"/>
        <ProjectReference Include="..\..\src\SwiftDotNet.Preview.Host\SwiftDotNet.Preview.Host.csproj"/>
        <!-- The [Inject] source generator, referenced as an analyzer so the generated IInjectable
             implementations are exercised by the DI tests. -->
        <ProjectReference Include="..\..\src\SwiftDotNet.SourceGenerators\SwiftDotNet.SourceGenerators.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    </ItemGroup>

</Project>
